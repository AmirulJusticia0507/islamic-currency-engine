PORT=5000

# Dialect: mysql (TiDB / CockroachDB NewSQL) atau sqlite (dev lokal tanpa DB)
DB_DIALECT=sqlite
SQLITE_PATH=./data/idce.sqlite

# NewSQL Connection String (TiDB / CockroachDB)
NEWSQL_HOST=127.0.0.1
NEWSQL_PORT=4000
NEWSQL_USER=root
NEWSQL_PASSWORD=secret_password
NEWSQL_DB=islamic_currency_db

# Security & Cryptography
CURRENCY_SECRET_KEY=secret_key_syariah_digital_currency
RSA_PRIVATE_KEY_PATH=./keys/private_key.pem
RSA_PUBLIC_KEY_PATH=./keys/public_key.pem

# Legal
NOTARY_ESIGN_PASSPHRASE=notary_placeholder

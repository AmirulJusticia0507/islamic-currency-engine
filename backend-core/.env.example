PORT=5000

# Dialect: sqlite (dev lokal tanpa DB) atau postgres (CockroachDB NewSQL)
DB_DIALECT=sqlite
SQLITE_PATH=./data/idce.sqlite

# CockroachDB (NewSQL) - protokol PostgreSQL
COCKROACH_HOST=127.0.0.1
COCKROACH_PORT=26257
COCKROACH_USER=root
COCKROACH_PASSWORD=
COCKROACH_DB=islamic_currency_db
COCKROACH_SSL=true

# Security & Cryptography
CURRENCY_SECRET_KEY=secret_key_syariah_digital_currency
RSA_PRIVATE_KEY_PATH=./keys/private_key.pem
RSA_PUBLIC_KEY_PATH=./keys/public_key.pem
JWT_SECRET=idce_jwt_secret_production_change_me
JWT_EXPIRES=12h

# Legal
NOTARY_ESIGN_PASSPHRASE=notary_placeholder
